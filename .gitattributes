# bash 脚本必须保持 LF，Windows 批处理用 CRLF
* text=auto
*.sh text eol=lf
agys text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
Makefile text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
# PowerShell 5.1 需要 UTF-8 BOM 才能正确读取中文；CRLF 是 Windows 脚本惯例
*.ps1 text eol=crlf
